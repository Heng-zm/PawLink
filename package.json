{
  "name": "pawlink-pro",
  "private": true,
  "version": "4.2.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "predev": "node scripts/doctor.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --watch --watch-preserve-output server/index.mjs",
    "build": "vite build",
    "start": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/doctor.mjs && node --check server/index.mjs && node --check scripts/dev.mjs && node --check scripts/doctor.mjs && vite build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "4.3.3",
    "vite": "8.1.5"
  },
  "devDependencies": {}
}
